# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to Git!

# GitHub Configuration
NUXT_GITHUB_USERNAME=your-github-username
NUXT_GITHUB_API_KEY=your-github-personal-access-token

# WakaTime API
NUXT_WAKATIME_API_KEY=waka_your-wakatime-api-key

# Upstash Redis
NUXT_UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
NUXT_UPSTASH_REDIS_REST_TOKEN=your-upstash-token


